{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/yonghyeokrhee/Palgwae/v0.1.0/ontology/schemas/evidence.schema.json",
  "title": "Context graph evidence",
  "type": "object",
  "required": [
    "evidence_id",
    "source_type",
    "source_name",
    "revision",
    "path",
    "locator",
    "content_hash",
    "extractor"
  ],
  "properties": {
    "evidence_id": {"type": "string", "minLength": 1},
    "source_type": {"type": "string", "minLength": 1},
    "source_name": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "minLength": 1},
    "path": {"type": "string", "minLength": 1},
    "locator": {"type": "string", "minLength": 1},
    "content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "extractor": {"type": "string", "minLength": 1},
    "environment": {"type": ["string", "null"]},
    "attributes": {"type": "object"}
  },
  "additionalProperties": false
}
