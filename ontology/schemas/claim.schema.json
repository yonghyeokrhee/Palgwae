{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/yonghyeokrhee/Palgwae/v0.1.0/ontology/schemas/claim.schema.json",
  "title": "Context graph claim",
  "type": "object",
  "required": [
    "claim_id",
    "subject",
    "predicate",
    "object",
    "assertion_kind",
    "review_status",
    "evidence_ids"
  ],
  "properties": {
    "claim_id": {"type": "string", "minLength": 1},
    "subject": {"type": "string", "minLength": 1},
    "predicate": {"type": "string", "minLength": 1},
    "object": {"type": "string", "minLength": 1},
    "assertion_kind": {
      "enum": ["DECLARED", "OBSERVED", "HUMAN_APPROVED", "INFERRED"]
    },
    "review_status": {
      "enum": ["AUTO_VERIFIED", "HUMAN_APPROVED", "CANDIDATE", "REJECTED"]
    },
    "evidence_ids": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1,
      "uniqueItems": true
    },
    "scope": {"type": "object"},
    "attributes": {"type": "object"},
    "valid_from": {"type": ["string", "null"]},
    "valid_to": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
