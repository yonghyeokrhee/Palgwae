{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/yonghyeokrhee/Palgwae/v0.1.0/ontology/schemas/manifest.schema.json",
  "title": "Portable graph bundle manifest",
  "type": "object",
  "required": ["schema_version", "snapshot_id", "files", "sources", "ontology"],
  "properties": {
    "schema_version": {"const": "1"},
    "snapshot_id": {"type": "string", "minLength": 1},
    "files": {
      "type": "object",
      "required": [
        "nodes.jsonl",
        "evidence.jsonl",
        "claims.jsonl",
        "unresolved.jsonl"
      ],
      "properties": {
        "nodes.jsonl": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "evidence.jsonl": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "claims.jsonl": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "unresolved.jsonl": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["name", "revision"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "revision": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "ontology": {
      "type": "object",
      "required": [
        "name",
        "version",
        "entities_sha256",
        "relations_sha256"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "entities_sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "relations_sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "build": {"type": "object"}
  },
  "additionalProperties": false
}
